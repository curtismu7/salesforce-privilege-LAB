# Names only. Copy to .env (mode 600, git-ignored) beside docker-compose.yml. Mock needs none of this.
# Easiest: run scripts/setup-real.sh in your own terminal; it makes the key and certificate and writes this file (hidden input for the secrets).
# REAL mode is OWNER-RUN and READ-ONLY: one JWT-bearer sign-in to this one origin, then a list of the org's permission sets and users.
# SF_LOGIN_URL=            # the org's My Domain origin, https only, no path (the sign-in's audience and the only host the lab will contact)
# SF_CLIENT_ID=            # the External Client App's Consumer Key
# SF_USERNAME=             # the Salesforce Username (not the email) of the authorized user
# SF_PRIVATE_KEY_PATH=     # path to an RSA private key in PEM form; the key is never returned, logged or cached
# SFPRIV_DEFAULT_SOURCE=   # mock | real | auto (default auto: Real if configured, else Mock; the Docker image forces mock)
# Per-run settings (shell): PORT=7835 (this lab's only port), SFPRIV_BIND=127.0.0.1 (loopback unless you set this on purpose)
